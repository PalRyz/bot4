# ============================================================
# NOPALRYZ.exe - Environment variables
# Copy this file to .env and edit the values.
#   cp .env.example .env
# NEVER commit your real .env to git.
# ============================================================

# Bot identity
BOT_NAME=NOPALRYZ.exe
BOT_PREFIX=.

# Owner WhatsApp number(s).
# Use international format WITHOUT +, spaces, dashes or @s.whatsapp.net.
# Multiple owners are separated by commas.
# Example: OWNER_NUMBER=6281234567890,6289876543210
OWNER_NUMBER=

# Login method: pairing or qr
LOGIN_METHOD=pairing

# Only needed when LOGIN_METHOD=pairing
# International number without +, spaces or dashes.
# Example: PAIRING_PHONE=6281234567890
PAIRING_PHONE=

# Session directory (session data is not a credential secret in chat, keep it local)
SESSION_DIR=session

# Optional: Discord-style modern theme flag (true/false)
THEME=glitch

# ---- AI (OpenAI-compatible API) ----
# Use any provider that exposes the OpenAI /chat/completions endpoint.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# AI_REQUEST_LIMIT=2000
AI_MAX_TOKENS=700

# ---- Cooldown / anti-spam ----
COOLDOWN_MS=3000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ---- Media / downloads ----
# Path to ffmpeg binary if it is not in PATH.
# FFMPEG_PATH=/data/data/com.termux/files/usr/bin/ffmpeg
# Path to yt-dlp binary if it is not in PATH.
# YTDLP_PATH=/data/data/com.termux/files/usr/bin/yt-dlp

# ---- Legacy/admin safety ----
# When true, sensitive group actions require an explicit, authorized command.
SAFE_ADMIN_MODE=true

# --- Misc ---
# MAX_BROADCAST_GROUPS=200
